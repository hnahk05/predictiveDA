{
  "description": "Fill estimated_seconds with measured conservative durations before using deadline guard. Sequential pretrain -> forecast for each dataset.",
  "runs": [
    {
      "id": "METR-LA-pretrain",
      "estimated_seconds": 0,
      "command": [
        "{python}",
        "{root}/scripts/run_training.py",
        "--config",
        "config_paper/METR-LA/pretraining.py",
        "--attempt",
        "{attempt}"
      ],
      "artifacts": [
        "completed.json",
        "**/*_best_val_loss.pt"
      ],
      "resume": true
    },
    {
      "id": "METR-LA-forecast",
      "estimated_seconds": 0,
      "command": [
        "{python}",
        "{root}/scripts/run_training.py",
        "--config",
        "config_paper/METR-LA/forecasting.py",
        "--attempt",
        "{attempt}",
        "--pretrained-dir",
        "{dependency:METR-LA-pretrain}"
      ],
      "artifacts": [
        "completed.json",
        "**/*_best_val_loss.pt",
        "**/test_export_*/metadata.json",
        "**/test_export_*/batch_*.npz"
      ],
      "depends_on": [
        "METR-LA-pretrain"
      ],
      "resume": true
    },
